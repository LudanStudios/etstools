<Page
    x:Class="ETSAssistant.WinUI3.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ResponsiveContent" Margin="30,26,30,30" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
            <SymbolIcon Symbol="Repair" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="开发者工具" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="高级诊断、虚拟麦克风、抓包、日志和重置操作。"
                       FontSize="15" Opacity="0.72" />
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2" Margin="4,8,0,0">
                    <TextBlock Text="自动听力测试" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="选择题和听力自动答题相关的调试端口与日志工具。" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <SymbolIcon Symbol="Globe" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="本地调试端口" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="PortDot" Width="9" Height="9" Fill="#94A3B8" />
                                <TextBlock x:Name="PortStatusText" Text="检查中…" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="http://127.0.0.1:10086/json/list" FontFamily="Consolas" FontSize="14"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="ETS 需要使用 --remote-debugging-port=10086 启动；端口未开放时请先打开 ETS。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenList_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Globe" />
                                    <TextBlock Text="查看 /json/list" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenVersion_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Globe" />
                                    <TextBlock Text="查看 /json/version" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopyPort_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="复制地址" />
                                </StackPanel>
                            </Button>
                            <Button Click="RefreshPort_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="刷新状态" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <SymbolIcon Symbol="World" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="抓包模式" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CaptureToggle" Grid.Column="1" OnContent="" OffContent=""
                                          Toggled="CaptureToggle_Toggled" />
                        </Grid>
                        <TextBlock Text="启用后连接 10086 的 DevTools 网络域。每次检测到答题提交完成，会等待 3 秒并把最近的数据包追加到抓包文件；导出日志时会一起打包。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="CaptureStatusText" Text="未启用" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="CapturePathText" FontFamily="Consolas" FontSize="12" Opacity="0.7"
                                   TextWrapping="Wrap" />
                        <Button Click="OpenCapture_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="打开抓包文件" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="详细级别日志" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="开启后增加 INFO 操作轨迹，记录窗口、导航、按钮、设置及任务状态；默认始终记录 WARN、ERROR、FATAL。不会记录凭据内容。"
                                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="VerboseLoggingToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                      Toggled="VerboseLoggingToggle_Toggled" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Spacing="2" Margin="4,8,0,0">
                    <TextBlock Text="自动口语测试" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="口语题分析、DeepSeek 生成、TTS 合成和虚拟声卡播放。" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Play" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="自动口语" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource BetaBadgeStyle}">
                                <TextBlock Text="BETA" FontSize="10" FontWeight="SemiBold" Foreground="#FF5B430F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="自动完成开始、跳过放音、开录、播放 TTS、停止和下一题；练习结束后自动清理 temp 音频。需要 ETS 已打开口语题，且这份试卷已预生成整卷 TTS。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock x:Name="SpeakingModeSummaryText" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.8" />
                            <Button x:Name="AutoSpeakingButton" Click="AutoSpeaking_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock x:Name="AutoSpeakingButtonText" Text="开始自动口语" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="AutoSpeakingStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Audio" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="语音注入（虚拟麦克风）" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="把 TTS 生成的 WAV 转成 16-bit / 48 kHz，然后让 ETS 带 Chromium 假麦克风参数启动，ETS 录音时会把这个 WAV 当作麦克风输入。需要先关闭 ETS。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="AudioStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <CheckBox x:Name="LoopAudioCheck" Content="循环播放 WAV" IsChecked="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="PickSpeakingWav_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="OpenFile" />
                                    <TextBlock Text="选择 WAV 并准备" />
                                </StackPanel>
                            </Button>
                            <Button Click="UseLastTtsWav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Audio" />
                                    <TextBlock Text="使用最近 TTS WAV" />
                                </StackPanel>
                            </Button>
                            <Button Click="LaunchEtsWithFakeMic_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="用虚拟麦克风启动 ETS" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <SymbolIcon Symbol="Message" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="DeepSeek 口语测试" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <ProgressRing x:Name="DeepSeekProgress" Grid.Column="1" Width="20" Height="20"
                                          IsActive="False" />
                        </Grid>
                        <TextBlock Text="模型 deepseek-flash。每次请求都会附带题干和 llm_stt.md 附件，返回文本只包含模型输出正文。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="DeepSeekStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <Button Click="LoadSpeakingQuestions_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="读取所有试卷口语题" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="SpeakingPaperBox" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Display"
                                  PlaceholderText="选择试卷（读取后可选）"
                                  SelectionChanged="SpeakingPaperBox_SelectionChanged" />
                        <ComboBox x:Name="SpeakingQuestionBox" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Display"
                                  PlaceholderText="选择口语题（读取试卷后可选）"
                                  SelectionChanged="SpeakingQuestionBox_SelectionChanged" />
                        <TextBox x:Name="SpeakingStemBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                                 PlaceholderText="输入口语题干，例如：朗读下面这段话……" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AskDeepSeekButton" Click="AskDeepSeek_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Send" />
                                    <TextBlock x:Name="AskDeepSeekText" Text="发送到 DeepSeek" />
                                </StackPanel>
                            </Button>
                            <Button Click="ClearSpeaking_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="清空" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopySpeakingResult_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="复制结果" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="SpeakingResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="150" PlaceholderText="模型返回的文本会显示在这里。" />
                        <TextBlock Text="阿里云标准 TTS · Betty 美式英文女声 · WAV 16 kHz。超过 300 字符会自动分段合成并拼接。需要在“答题设置”中填写阿里云个人凭据。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AliyunTtsButton" Click="AliyunTts_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="阿里云 TTS 生成并播放" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="AliyunTtsProgress" Width="20" Height="20" IsActive="False" />
                        </StackPanel>
                        <TextBlock x:Name="AliyunTtsStatusText" FontSize="12" Opacity="0.72"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Audio" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="整卷口语音频（预生成 → 播放）" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="先在上方选择试卷，再按当前口语模式（标答/灵活）为每题生成答案并合成 TTS。全部完成后，录音时把对应 WAV 播放到虚拟声卡 CABLE Input；ETS 麦克风需要选择 CABLE Output。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="CableStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock x:Name="DefaultMicStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="SetVirtualMicDefault_Click" Content="设为默认输入" />
                            <Button Click="RestoreDefaultMic_Click" Content="恢复原默认输入" />
                        </StackPanel>
                        <ProgressBar x:Name="BatchProgress" Minimum="0" Maximum="1" Value="0"
                                     Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="GenerateSessionButton" Click="GenerateSession_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="预生成整卷 TTS" />
                                </StackPanel>
                            </Button>
                            <Button Click="RefreshCable_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="刷新虚拟声卡" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenSoundSettings_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Setting" />
                                    <TextBlock Text="打开声音设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="BatchStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Text="播放列表" FontSize="14" FontWeight="SemiBold" />
                        <ComboBox x:Name="SessionItemBox" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Display" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="PlaySessionItem_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="播放到虚拟声卡" />
                                </StackPanel>
                            </Button>
                            <Button Click="PreviewSessionItem_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Audio" />
                                    <TextBlock Text="本地试听" />
                                </StackPanel>
                            </Button>
                            <Button Click="PlayNextSessionItem_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Next" />
                                    <TextBlock Text="下一题到声卡" />
                                </StackPanel>
                            </Button>
                            <Button Click="StopSessionPlayback_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Stop" />
                                    <TextBlock Text="停止" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="“播放到虚拟声卡”是静音的，只给 ETS 录音用；要自己听请点“本地试听”。"
                                   FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                        <TextBlock x:Name="SessionStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="2" Margin="4,8,0,0">
                    <TextBlock Text="诊断与维护" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="运行日志、抓包、程序信息和重置操作。" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                </StackPanel>


                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Document" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="日志与诊断" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="LogSummaryText" FontSize="13" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Text="导出会打包后台日志、ETS Tool 诊断日志、配置和当前环境信息。"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ExportLogs_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="导出日志 ZIP" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenData_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Folder" />
                                    <TextBlock Text="打开后台日志目录" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenDiagnosticLogs_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Folder" />
                                    <TextBlock Text="打开诊断日志目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="ReportHacked" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="程序信息" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="EnvironmentText" FontFamily="Consolas" FontSize="12" Opacity="0.76"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="CopyEnvironment_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="复制环境信息" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenProgram_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Folder" />
                                    <TextBlock Text="打开程序目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="#7F1D1D" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Important" Foreground="#EF4444" />
                            <TextBlock Text="完全重置" FontSize="17" FontWeight="SemiBold" Foreground="#EF4444" />
                        </StackPanel>
                        <TextBlock Text="停止后台监听并移除开机启动和快捷方式，清除 DeepSeek/阿里云凭证、界面偏好、虚拟麦克风 WAV 和助手日志。不会删除试卷包、答题历史或答案记录。"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <Button Click="FullReset_Click" Background="#DC2626" Foreground="White" BorderBrush="#DC2626">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" Foreground="White" />
                                <TextBlock Text="完全重置" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
